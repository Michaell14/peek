<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Applied only to builds signed with a real certificate, which run under
	     the hardened runtime. There, EventKit (the Calendar and Reminders
	     widgets) is refused without this. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
